#% if app_repos %#
#% for repo in app_repos %#
#% for ns in repo.namespaces %#
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: tenant-quota
  namespace: #{ ns }#
spec:
  hard:
    # Quoted: a bare 4 or 50 is retyped to an int by whoever parses the file,
    # and ResourceQuota takes quantities.
    requests.cpu: "#{ repo.quota.cpu }#"
    requests.memory: "#{ repo.quota.memory }#"
    pods: "#{ repo.quota.pods }#"
    # The LAN-IP grant (D9). 0 without one: a tenant with no grant can create
    # no LoadBalancer Service at all, whatever the pools would do.
    services.loadbalancers: "#{ repo.grants.lan_ip }#"
    # A NodePort is LAN presence on every node's address, which no grant
    # gives. LoadBalancer Services allocate node ports too unless they set
    # `allocateLoadBalancerNodePorts: false` — Cilium's L2 announcement does
    # not need them.
    services.nodeports: "0"
---
# Without default requests the quota above rejects every Pod that does not
# state its own, which reads as the tenant's app being broken.
apiVersion: v1
kind: LimitRange
metadata:
  name: tenant-defaults
  namespace: #{ ns }#
spec:
  limits:
    - type: Container
      defaultRequest:
        cpu: 100m
        memory: 128Mi
#% endfor %#
#% endfor %#
#% endif %#
