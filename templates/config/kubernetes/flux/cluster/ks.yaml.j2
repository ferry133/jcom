---
# Flux entry point for this per-user cluster.
# Defines the jg-base GitRepository and all Kustomizations.
# Generated by task configure from cluster.yaml.

# ── cluster-secrets — SOPS-decrypted from per-user repo ──────────────────────
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: cluster-secrets
  namespace: flux-system
spec:
  decryption:
    provider: sops
  interval: 1h
  path: ./kubernetes/components/sops
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
---
# ── GitRepository — points to jg-base ────────────────────────────────────────
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: jg-base
  namespace: flux-system
spec:
  interval: 1h
  url: https://github.com/ferry133/jg-base
  ref:
    branch: main
---
# ── Base Kustomization — installed on every cluster ───────────────────────────
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: cluster-apps-base
  namespace: flux-system
spec:
  decryption:
    provider: sops
  deletionPolicy: WaitForTermination
  interval: 1h
  path: ./kubernetes/apps/base
  prune: true
  sourceRef:
    kind: GitRepository
    name: jg-base
    namespace: flux-system
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  wait: false
  patches:
    - patch: |-
        apiVersion: kustomize.toolkit.fluxcd.io/v1
        kind: Kustomization
        metadata:
          name: _
        spec:
          decryption:
            provider: sops
          deletionPolicy: WaitForTermination
          patches:
            - patch: |-
                apiVersion: helm.toolkit.fluxcd.io/v2
                kind: HelmRelease
                metadata:
                  name: _
                spec:
                  install:
                    crds: CreateReplace
                    strategy:
                      name: RetryOnFailure
                  rollback:
                    cleanupOnFail: true
                    recreate: true
                  upgrade:
                    cleanupOnFail: true
                    crds: CreateReplace
                    strategy:
                      name: RemediateOnFailure
                    remediation:
                      remediateLastFailure: true
                      retries: 2
              target:
                group: helm.toolkit.fluxcd.io
                kind: HelmRelease
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
    # ── jcom-only Cilium override (this single-node cluster HOSTS Omni) ──────────
    # Global jg-base Cilium uses vxlan tunnel + MTU 1370 for KubeSpan multi-node
    # clusters. On jcom that 1370 pod-MTU is too small for Omni's SideroLink
    # WireGuard → "sendmmsg: message too long" → Omni UI / kubectl go slow.
    # jcom needs no KubeSpan (single node) → revert Cilium to native + MTU 1500.
    # JSON6902 append (NOT strategic-merge): appends to the `cilium` child
    # Kustomization's spec.patches so the generic HR-strategy patch above is kept
    # (a 2nd strategic-merge would REPLACE the whole patches list — verified).
    - patch: |-
        - op: add
          path: /spec/patches/-
          value:
            patch: |-
              apiVersion: helm.toolkit.fluxcd.io/v2
              kind: HelmRelease
              metadata:
                name: cilium
              spec:
                values:
                  routingMode: native
                  ipv4NativeRoutingCIDR: "10.42.0.0/16"
                  autoDirectNodeRoutes: true
                  MTU: 1500
                  loadBalancer:
                    mode: "dsr"
            target:
              group: helm.toolkit.fluxcd.io
              kind: HelmRelease
              name: cilium
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
        name: cilium
    # ── jcom-only: disable Spegel (single-node cluster) ─────────────────────────
    # Spegel is a peer-to-peer image mirror — pointless on 1 node, and the
    # cluster-template disables it for single-node (spegel_enabled = nodes > 1).
    # jg-base deploys it unconditionally; on jcom it never became Ready and, before
    # dying, wrote /etc/cri/conf.d/hosts/_default/hosts.toml mirroring ALL registries
    # to dead :29999/:30021 → every uncached image pull failed cluster-wide.
    # Suspend the spegel child Kustomization so Flux stops reconciling/recreating it.
    # (Scalar-only strategic merge: does NOT set spec.patches, so the generic
    # HR-strategy patch above is preserved.)
    - patch: |-
        apiVersion: kustomize.toolkit.fluxcd.io/v1
        kind: Kustomization
        metadata:
          name: spegel
          namespace: flux-system
        spec:
          suspend: true
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
        name: spegel
---
# ── claude-code instances (base; per-cluster rendered from claude_instances) ──
# The shared pieces (namespace, SA/RBAC, OCIRepository, secrets) come from
# apps/base/claudecode in jg-base; only the per-instance HelmReleases are
# rendered here, because instance names and the optional oauth2-proxy /
# talos-mcp sidecars are template-time structure, not Flux values.
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: claude-code-instances
  namespace: flux-system
spec:
  decryption:
    provider: sops
  deletionPolicy: WaitForTermination
  interval: 1h
  path: ./kubernetes/apps/base/claudecode/claude-code/instances
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  dependsOn:
    - name: cluster-apps-base
#| claudecode/claude-code and monitoring/daily-check moved from extras to base
   (2026-08-07); the filter below skips them so a per-user cluster.yaml that
   still lists either does not render a Kustomization pointing at a jg-base
   path that no longer exists. #|
#% set _now_base = ['claudecode/claude-code', 'monitoring/daily-check'] %#
#% for extra in extras | default([]) if extra not in _now_base %#
#% set _app = extra.split('/')[1] %#
---
# ── extras/#{extra}# ─────────────────────────────────────────────────────────
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: extras-#{_app}#
  namespace: flux-system
spec:
  decryption:
    provider: sops
  deletionPolicy: WaitForTermination
  interval: 1h
  path: ./kubernetes/apps/extras/#{extra}#
  prune: true
  sourceRef:
    kind: GitRepository
    name: jg-base
    namespace: flux-system
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  dependsOn:
    - name: cluster-apps-base
#% endfor %#
